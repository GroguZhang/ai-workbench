# ===== 球星卡拆卡解析器 环境变量配置 =====
# 复制本文件为 .env 并填入真实值：cp .env.example .env

# OpenAI / 兼容接口的 API Key（必填，除非使用 --mock）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Base URL（可选）
# - 官方 OpenAI：留空或不设置
# - OpenAI 兼容代理 / 自建网关：填写对应地址，例如：
#   OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_BASE_URL=

# 视觉模型名称（可选，默认 gpt-4o）
# - OpenAI: gpt-4o / gpt-4o-mini
# - 其他兼容接口请填对应模型 ID
OPENAI_MODEL=gpt-4o
