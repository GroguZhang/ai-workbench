# ==========================================
# CardHobby Sniper Radar 环境变量配置样例
# ==========================================
TZ=Asia/Shanghai

# ----------------- 推送通道配置 -----------------
# PushPlus 微信图文卡片 Token（留空则不推送）
PUSHPLUS_TOKEN=your_pushplus_token_here

# Bark iPhone 锁屏强提醒 URL（例如 https://api.day.app/your_key）
BARK_URL=

# 企业微信群机器人 Webhook 地址（留空则跳过）
WECHAT_WORK_WEBHOOK=

# ----------------- 算价与策略参数 -----------------
# 兜底运费（元）
DEFAULT_SHIPPING_RMB=12.0
# 是否优先使用卡淘返回的真实运费（1=启用，0=使用兜底）
USE_REAL_POSTAGE=1
# 空结果是否推送（0=静默，1=推送，建议保持 0 避免噪音）
PUSH_WHEN_EMPTY=0
# 请求间隔延迟（秒），防止被反爬限频
REQUEST_DELAY_SEC=2.0

# ----------------- 卡淘接口参数 -----------------
# 搜索接口每页条数
CARDHOBBY_PAGE_SIZE=60
# 登录态 Cookie / Token（留空则为匿名抓取）
CARDHOBBY_COOKIE=
CARDHOBBY_TOKEN=

# ----------------- 大模型智能终审与自学习 (DeepSeek) -----------------
# DeepSeek 官方 API Key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
# API 地址 (默认为官方接口 https://api.deepseek.com/v1)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 使用模型 (推荐 deepseek-chat，推理成本极低且响应迅速)
DEEPSEEK_MODEL=deepseek-chat
# 是否启用 Stage 2 终审门禁 (1=开启，0=关闭)
AI_GATEKEEPER_ENABLED=1
# 是否启用每日截标离群样本自动学习进化引擎 (1=开启，0=关闭)
AI_DAILY_LEARN_ENABLED=1

# ----------------- Topps 官方发售雷达（系列白名单与通知阈值） -----------------
# 系列监控白名单（逗号分隔，留空=监控全部系列）。支持中文别名（如 sapphire/蓝宝石）
TOPPS_SERIES_WHITELIST=
# 官方原价上限（元，0=不限价，超过此价格不推送）
TOPPS_MAX_OFFICIAL_PRICE=0
# 截止时间提醒窗口（小时，0=不限，仅在距截止 N 小时内才推送）
TOPPS_DEADLINE_WITHIN_HOURS=0
# 最低优先级分（0-100，0=不卡分，达标才推送）
TOPPS_MIN_SCORE=0
