# ==========================================
# CardHobby Sniper Radar 环境变量配置样例
# ==========================================
TZ=Asia/Shanghai

# ----------------- 推送通道配置 -----------------
# PushPlus 微信图文卡片 Token（留空则不推送）
PUSHPLUS_TOKEN=your_pushplus_token_here

# Bark iPhone 锁屏强提醒 URL（例如 https://api.day.app/your_key）
BARK_URL=

# 企业微信群机器人 Webhook 地址（留空则跳过）
WECHAT_WORK_WEBHOOK=

# ----------------- 算价与策略参数 -----------------
# 兜底运费（元）
DEFAULT_SHIPPING_RMB=12.0
# 是否优先使用卡淘返回的真实运费（1=启用，0=使用兜底）
USE_REAL_POSTAGE=1
# 空结果是否推送（0=静默，1=推送，建议保持 0 避免噪音）
PUSH_WHEN_EMPTY=0
# 请求间隔延迟（秒），防止被反爬限频
REQUEST_DELAY_SEC=2.0

# ----------------- 卡淘接口参数 -----------------
# 搜索接口每页条数
CARDHOBBY_PAGE_SIZE=60
# 登录态 Cookie / Token（留空则为匿名抓取）
CARDHOBBY_COOKIE=
CARDHOBBY_TOKEN=
